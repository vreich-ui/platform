---
// AdminLayout (T9.3) — static shell + client auth gate for the /admin/*
// workspace. Same three states as the legacy dashboard (signed-out,
// signed-in-but-not-admin, signed-in-admin), factored into a reusable layout.
// The signed-in slot holds a page island (e.g. AdminHome) mounted by the page.
// The real wall stays server-side in each function (getAdminStateFromEvent).
import '@site/config/policy-bindings'; // D2: register the site-identity provider before resolving it below
import '~/styles/admin-tokens.css';
import Layout from '~/layouts/Layout.astro';
import LoginModal from '~/components/common/LoginModal.astro';
import { getSiteIdentity } from '@core/lib/site-identity';

interface Props {
  title?: string;
}

const { title = 'Admin workspace' } = Astro.props;
const metadata = {
  title,
  robots: {
    index: false,
    follow: false,
  },
};

// Wolf 2026-08-18: the "signed in, no role" panel below names the site the
// person is a member of and links back to it — resolved server-side, same
// D2 pattern as admin/index.astro (the browser has no process.env, so an env
// override to SITE_BRAND_NAME would never reach a client-side call).
const { brandName } = getSiteIdentity();
---

<Layout metadata={metadata}>
  {
    /* The /admin/* workspace is a full-viewport app: its own sidebar + topbar
      are the chrome. Mount only the shared document layout and login modal:
      the reader-facing header/navigation and footer are deliberately absent
      from every admin route. */
  }
  <LoginModal />
  <div class="admin-gate adm-root">
    <p class="admin-gate-status" data-auth-status aria-live="polite" role="status"></p>

    <!-- Signed out -->
    <div data-admin-signin-prompt hidden class="admin-gate-panel">
      <p class="admin-gate-kicker">Admin login required</p>
      <p class="admin-gate-message">
        Sign in with your editor account to access the workspace. Public articles remain available without login.
      </p>
      <button type="button" class="btn-primary admin-gate-btn" data-admin-open-login>Sign in to editor</button>
    </div>

    <!-- Signed in, not an admin -->
    <div data-admin-forbidden-prompt hidden class="admin-gate-panel">
      <p class="admin-gate-kicker">Access restricted</p>
      <p class="admin-gate-message">
        You're signed in, but no workspace role has been granted to this email yet — ask an Owner to grant one. For
        now your tier is <strong data-admin-tier-label>Member</strong> of {brandName}.
      </p>
      <a class="btn-primary admin-gate-btn" href="/">Go to {brandName} home</a>
    </div>

    <!-- Signed-in admin: the workspace shell -->
    <div data-admin-shell-container hidden>
      <slot />
    </div>
  </div>
</Layout>

<style>
  .admin-gate {
    min-height: 60vh;
  }

  .admin-gate-status:empty {
    display: none;
  }

  .admin-gate-status {
    padding: 1rem;
    color: var(--adm-text-muted, #5b6470);
  }

  .admin-gate-panel {
    max-width: 32rem;
    margin: 3rem auto;
    padding: 1.5rem;
    border: 1px solid var(--adm-border, rgba(120, 120, 120, 0.3));
    border-radius: 0.75rem;
  }

  .admin-gate-kicker {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--adm-text-muted, #5b6470);
    margin-bottom: 0.25rem;
  }

  .admin-gate-message {
    margin: 0.5rem 0 1rem;
  }
</style>

<script>
  // eslint-disable-next-line @typescript-eslint/ban-ts-comment
  // @ts-nocheck
  // T14.0: register this site's identity/policy providers FIRST. goTrueClient
  // derives its localStorage keys from getSiteIdentity() at call time (W11
  // T11.5), which throws — silently, inside the storage helpers' catch blocks —
  // until the provider is registered. Without this the gate reads "signed out"
  // for a validly signed-in admin on every cold load.
  import '@site/config/policy-bindings';
  import { currentUser, getAccessToken, handleOAuthCallback } from '@core/lib/admin/goTrueClient';
  import { fetchAdminAccessState } from '@core/lib/admin/admin-access-client';

  (() => {
    const initializeAdminLayoutGate = () => {
      const pageRoot = document.querySelector('.admin-gate');
      if (!pageRoot || pageRoot.dataset.adminGateInitialized === 'true') return;
      pageRoot.dataset.adminGateInitialized = 'true';

      const shellContainer = document.querySelector('[data-admin-shell-container]');
      const authStatus = document.querySelector('[data-auth-status]');
      const signinPrompt = document.querySelector('[data-admin-signin-prompt]');
      const forbiddenPrompt = document.querySelector('[data-admin-forbidden-prompt]');
      const tierLabel = document.querySelector('[data-admin-tier-label]');

      // Wolf 2026-08-18: the forbidden panel's copy names the caller's real
      // tier instead of a flat "no role" dead end — admin-auth-state.ts now
      // always defaults a truly unassigned login to 'viewer' server-side
      // (ensureDefaultMembershipOnLogin), so `roles` here is normally
      // non-empty by the time this state renders; the `owner`/`admin` cases
      // never reach 'forbidden' at all (they render the shell instead).
      const TIER_LABELS = { publisher: 'Publisher', editor: 'Editor', viewer: 'Member' };
      const tierLabelFor = (roles) => {
        for (const role of ['publisher', 'editor', 'viewer']) {
          if (roles?.includes(role)) return TIER_LABELS[role];
        }
        return 'Member';
      };

      const setShellVisible = (visible) => {
        if (shellContainer) shellContainer.hidden = !visible;
      };

      const statusMessages = {
        checking: 'Checking editor access…',
        'signed-out': '',
        forbidden: '',
        error: 'Something went wrong. Please refresh or try again.',
        'signed-in': '',
      };

      const setAuthState = (state) => {
        if (authStatus) authStatus.textContent = statusMessages[state] ?? '';
        setShellVisible(state === 'signed-in');
        if (signinPrompt) signinPrompt.hidden = state !== 'signed-out';
        if (forbiddenPrompt) forbiddenPrompt.hidden = state !== 'forbidden';
      };

      document.querySelector('[data-admin-open-login]')?.addEventListener('click', () => {
        window.__cmsLoginModal?.open();
      });

      // S1 "failure states" fix, now shared with HeaderAuthButton.astro via
      // admin-access-client.ts: a transient problem checking admin access
      // (network failure, a non-2xx from the function, a cold-start/deploy
      // blip returning a non-JSON body) must never be presented the same way
      // as a genuine "you are not an admin" — that literal forbidden message
      // ("not listed in ADMIN_EMAILS") told a legitimate admin they lacked
      // access when the real cause was the CHECK failing, not the answer
      // being no. `checkFailed: true` marks that distinction for the caller.
      const getAdminStateForUser = async () => fetchAdminAccessState(await getAccessToken());

      const renderAuthState = async () => {
        const user = currentUser();
        if (!user) {
          setAuthState('signed-out');
          return;
        }
        const adminState = await getAdminStateForUser();
        if (adminState.checkFailed) {
          setAuthState('error');
          return;
        }
        if (tierLabel) tierLabel.textContent = tierLabelFor(adminState.roles);
        setAuthState(adminState.isAdmin ? 'signed-in' : 'forbidden');
      };

      const initializeIdentityAuth = async () => {
        setAuthState('checking');
        try {
          const oauthUser = await handleOAuthCallback();
          if (oauthUser) window.__cmsLoginModal?.close();
          await renderAuthState();
          document.addEventListener('cms:login', () => {
            renderAuthState().catch((error) => {
              console.error('Auth refresh failed.', error);
              setAuthState('error');
            });
          });
          document.addEventListener('cms:logout', () => {
            renderAuthState().catch((error) => {
              console.error('Auth refresh failed.', error);
              setAuthState('error');
            });
          });
        } catch (error) {
          console.error('Identity authentication initialization failed.', error);
          setAuthState('error');
        }
      };

      initializeIdentityAuth();
    };

    if (!window.__cmsAdminLayoutPageLoadListener) {
      window.__cmsAdminLayoutPageLoadListener = true;
      document.addEventListener('astro:page-load', initializeAdminLayoutGate);
    }

    initializeAdminLayoutGate();
  })();
</script>
