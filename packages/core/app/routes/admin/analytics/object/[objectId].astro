---
// Object analytics drill-down (T21.30; runner R11.4) — one placeholder page;
// the netlify.toml rewrite serves it for every /admin/analytics/object/<id>,
// and the island reads the id client-side from the URL (same pattern as
// /admin/content/[objectId].astro).
import '@site/config/policy-bindings'; // D2: register the site-identity provider before resolving it below
import { getSiteIdentity } from '@core/lib/site-identity';
import AdminLayout from '~/layouts/AdminLayout.astro';
import ObjectAnalyticsWorkspace from '~/admin/ObjectAnalyticsWorkspace';

export function getStaticPaths() {
  return [{ params: { objectId: '__object' } }];
}

// D2: resolve identity once, server-side, where process.env is real, and
// pass it down explicitly — the island must not call getSiteIdentity()
// itself (the browser has no process.env, so env overrides never reached it).
const identity = getSiteIdentity();
---

<AdminLayout title="Admin — Object analytics">
  <ObjectAnalyticsWorkspace client:load identity={identity} />
</AdminLayout>
