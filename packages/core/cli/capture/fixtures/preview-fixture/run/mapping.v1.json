      "pageBody": {
        "route": "/about",
        "pageType": "standard",
        "title": "About Larkmoor",
        "seo": {
          "description": "How Larkmoor Press works, and where to find its books."
        },
        "sections": [
          {
            "id": "s_032f27274e",
            "type": "lede",
            "data": {
              "heading": "About Larkmoor",
              "body": "<p>A two-person press working to a deliberately small calendar.</p>",
              "actions": [
                {
                  "label": "Home",
                  "target": {
                    "kind": "route",
                    "href": "/"
                  },
                  "style": "primary"
                },
                {
                  "label": "About",
                  "target": {
                    "kind": "route",
