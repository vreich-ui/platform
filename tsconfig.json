{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "strictNullChecks": true,
    "allowJs": true,
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "~/assets/*": ["sites/drlurie/assets/*"],
      "~/*": ["packages/core/app/*"],
      "@core/*": ["packages/core/*"],
      "@site/*": ["sites/drlurie/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist/",
    // T21.5: Netlify EDGE functions run on Deno and import their
    // dependency with an explicit `.ts` specifier, which tsc rejects
    // (TS5097). They are deliberately thin wrappers — every decision
    // they make lives in packages/core/lib/tracking/experiments/, which
    // IS type-checked and unit-tested.
    "netlify/edge-functions/",
    "sites/*/netlify/edge-functions/"
  ]
}
