+    seedBase: z.number().int().nonnegative(),
+    // Layer 2 slot: at most one trained per-brand LoRA today.
+    lora: brandImageryLoraSchema.optional(),
+  })
+  .strict();
+export type BrandImagery = z.infer<typeof brandImagerySchema>;
