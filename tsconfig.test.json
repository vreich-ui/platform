{
  "compilerOptions": {
    "allowJs": true,
    "strictNullChecks": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "outDir": ".tmp/ci-test",
    "rootDir": ".",
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": false
  },
  "include": [
    "netlify/**/*.ts",
    "src/**/*.test.ts",
    "tests/netlify/**/*.ts",
    "tests/e2e/**/*.ts",
    "tests/e2e/**/*.mjs",
    "packages/core/**/*.ts",
    "sites/**/*.ts"
  ],
  "exclude": [
    // W14 T14.1: the app SHELL is Astro/Vite territory — its modules resolve
    // `~/…`, `@site/…`, and the `astrowind:config` virtual module, none of
    // which tsc can see. Excluding it from the blanket include restores the
    // pre-T14.1 arrangement (these files lived under `src/`, which was never
    // swept in either): a shell module a Node test actually imports is still
    // compiled, as a reachable dependency, and must therefore keep RELATIVE
    // cross-package imports rather than the aliases.
    "packages/core/app/**",
    "sites/*/app/**",
    "sites/*/astro.config.ts",
    "packages/core/admin/**/*.tsx",
    "packages/core/admin/index.ts",
    "packages/core/components/**",
    "packages/core/lib/registry/components/index.ts"
  ]
}
