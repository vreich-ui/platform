{
  "name": "@onwidget/astrowind",
  "version": "1.0.0-beta.52",
  "description": "AstroWind: A free template using Astro 5.0 and Tailwind CSS. Astro starter theme.",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/validate-upload-images.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "npm run check:astro && npm run check:eslint && npm run check:prettier",
    "check:astro": "astro check",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,js,jsx,astro,css}\" \"scripts/**/*.{ts,js}\"",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier -w .",
    "test": "rm -rf .tmp/ci-test && tsc -p tsconfig.test.json && (cd .tmp/ci-test && node --test); s1=$?; node --test tests/scripts/*.test.mjs; s2=$?; rm -rf .tmp/ci-test; [ \"$s1\" = 0 ] && [ \"$s2\" = 0 ]",
    "test:opt-in": "rm -rf .tmp/save-opt-in-test; tsc -p tests/netlify/tsconfig.json && node --test .tmp/save-opt-in-test/tests/netlify/*.test.js; status=$?; rm -rf .tmp/save-opt-in-test; exit $status",
    "site:create": "node packages/core/cli/create-site.mjs",
    "site:genesis": "node scripts/site-genesis-drive.mjs",
    "site:verify": "node scripts/site-genesis-drive.mjs --verify",
    "fleet:parity": "node scripts/audit-site-admin-parity.mjs --all",
    "fleet:capability": "node scripts/fleet-capability-probe.mjs --all"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.4.2",
    "@astrolib/seo": "^1.0.0-beta.8",
    "@contentful/rich-text-html-renderer": "^17.2.2",
    "@contentful/rich-text-types": "^17.2.7",
    "@fontsource-variable/inter": "^5.2.6",
    "@netlify/blobs": "^10.7.0",
    "@openai/agents": "^0.11.3",
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "astro": "^5.12.9",
    "astro-embed": "^0.9.0",
    "astro-icon": "^1.1.5",
    "diff": "^9.0.0",
    "limax": "4.1.0",
    "lodash.merge": "^4.6.2",
    "openai": "^6.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.3.1",
    "unpic": "^4.1.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.3.3",
    "@astrojs/partytown": "^2.1.4",
    "@astrojs/react": "^4.4.2",
    "@astrojs/tailwind": "^5.1.5",
    "@eslint/js": "^9.33.0",
    "@iconify-json/flat-color-icons": "^1.2.1",
    "@iconify-json/tabler": "^1.2.20",
    "@tailwindcss/typography": "^0.5.16",
    "@types/diff": "^7.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "astro-compress": "2.3.8",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^9.33.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^16.3.0",
    "js-yaml": "^4.1.0",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "reading-time": "^1.5.0",
    "sharp": "0.34.3",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0",
    "unist-util-visit": "^5.0.0"
  }
}
