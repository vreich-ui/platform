    "alt": "A woman in her 50s applying facial moisturizer beside a bathroom mirror",
    "src": "/img/req_plugin_skin_after_50_20260906_01/3a800dc753c9557393dfead52c26dd346f4c810de7f24a8757bb74cf63f884d8.webp"
