            },
            {
              "content": [
                {
                  "data": {},
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "nodeType": "text",
                  "value": "How to care for your skin in your 60s and 70s"
                },
                {
                  "data": {},
                  "marks": [],
                  "nodeType": "text",
                  "value": " — American Academy of Dermatology. "
                },
                {
                  "content": [
                    {
                      "data": {},
                      "marks": [],
