                      "value": "Read the guidance"
                    }
                  ],
                  "data": {
                    "uri": "https://www.aad.org/public/everyday-care/skin-care-basics/care/skin-care-in-your-60s-and-70s"
                  },
                  "nodeType": "hyperlink"
                }
              ],
              "data": {},
              "nodeType": "paragraph"
            },
            {
              "content": [
                {
                  "data": {},
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ],
                  "nodeType": "text",
                  "value": "Caring for your skin in menopause"
                },
                {
                  "data": {},
                  "marks": [],
                  "nodeType": "text",
                  "value": " — American Academy of Dermatology. "
                },
                {
                  "content": [
                    {
                      "data": {},
                      "marks": [],
                      "nodeType": "text",
                      "value": "Read the guidance"
                    }
