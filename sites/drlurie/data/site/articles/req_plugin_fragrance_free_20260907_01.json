          "contentType": "image/webp",
          "sizeBytes": 61472,
          "src": "/img/req_plugin_fragrance_free_20260907_01/117632efb5390ac61d7406a462d1b1bd63f41e1945d9f27348cf94a4a9a4cc84.webp",
          "type": "image"
        },
        "title": "Where the answer actually is"
      },
      "rendering": {
        "emphasis": "medium",
