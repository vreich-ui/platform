---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import GridItem from '~/components/blog/GridItem.astro';
import ObjectSections from '~/components/cms/ObjectSections.astro';
import { fetchPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';
import { loadRoutePageObject, resolveRouteTermId, routeHeaderAnnotation } from '~/utils/route-page-object';

export const prerender = true;

export const getStaticPaths = (async () => {
  const posts = await fetchPosts();
  const topics = new Map<string, { title: string; slug: string }>();

  posts.forEach((post) => {
    if (post.category) topics.set(post.category.slug, post.category);
  });

  return Array.from(topics.values()).map((topic) => ({
    params: { topicSlug: topic.slug },
    props: {
      topic,
      posts: posts.filter((post) => post.category?.slug === topic.slug),
    },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { topic, posts } = Astro.props as Props;

// W6 (T6.1): ONE `page_topic_detail` object (pageType 'listing') serves every
// topic page — pattern copy, `%term%` interpolated with this category's
// display label (topics remain category presentations, D§5.5). The post grid
// and the back-link stay computed furniture.
const detail = await loadRoutePageObject('page_topic_detail', topic.title);
const topicTermId = await resolveRouteTermId('category', topic.slug);
const header = detail?.header ?? {
  kicker: 'Topic',
  heading: topic.title,
  paragraphs: ['A focused collection of Dr. Lurié education assigned to this category in article frontmatter.'],
};

const metadata = {
  title: detail?.title ?? `${topic.title} articles`,
  description: detail?.seo.description ?? `Science-led Dr. Lurié articles about ${topic.title}.`,
};
---

<Layout metadata={metadata}>
  <section class="dl-section" data-cms-term-id={topicTermId}>
    <a class="text-sm font-semibold text-primary hover:text-secondary" href={getPermalink('/learn/topics')}>
      ← All topics
    </a>
    <div class="mt-4 rounded-3xl bg-gradient-to-br from-sky-50 via-amber-50 to-transparent p-6 sm:p-10">
      <div style="display:contents" {...routeHeaderAnnotation('page_topic_detail', detail?.header)}>
        {header.kicker && <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">{header.kicker}</p>}
        <h1 class="mt-3 text-4xl font-bold capitalize sm:text-5xl" set:html={header.heading} />
        {header.paragraphs.map((paragraph) => <p class="dl-reading mt-5 text-muted" set:html={paragraph} />)}
      </div>
    </div>

    <div class="mt-10 grid gap-8 md:grid-cols-2">
      {posts.map((post) => <GridItem post={post} />)}
    </div>
  </section>
  <ObjectSections objectId="page_topic_detail" sections={detail?.extraSections ?? []} />
</Layout>
